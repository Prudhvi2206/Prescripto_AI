# ==========================================
# 🚀 Prescripto AI Global .gitignore Config
# ==========================================

# --- OS / IDE files ---
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Python / Backend ---
backend/venv/
backend/.env
backend/sql_app.db
backend/prescripto.db
backend/__pycache__/
backend/**/*.pyc
backend/scratch/
__pycache__/
*.py[cod]
*$py.class

# --- Node / Frontend ---
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env*
frontend/.vercel/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# --- Logs & Diagnostics ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/lint_errors.json
frontend/lint_errors.log
frontend/lint_errors.txt
